<%# Override de Decidim: el boton de acceso externo debe enviar un POST real.
    El partial original usa <a data-method="post">, que solo funciona cuando
    rails-ujs ya ha cargado y ejecutado. En este despliegue la pagina incluye
    un SVG inline muy grande y el bundle decidim_core pesa ~2 MB, por lo que
    un clic realizado antes de que termine el JS se convierte en GET y OmniAuth
    responde 404 "Not found. Authentication passthru.". %>
<% is_horizontal = false unless local_assigns.has_key?(:is_horizontal) %>
<% if Devise.mappings[:user].omniauthable? && current_organization.enabled_omniauth_providers.any? %>
  <div class="login__omniauth<%= " login__omniauth__horizontal" if is_horizontal %>">
    <%- current_organization.enabled_omniauth_providers.keys.each do |provider| %>
      <% link_classes = "login__omniauth-button login__omniauth-button--#{normalize_provider_name(provider)}" %>
      <% provider_label = t("devise.shared.links.log_in_with_provider", provider: normalize_provider_name(provider).titleize) %>
      <form action="<%= decidim.send("user_#{provider}_omniauth_authorize_path") %>" method="post" class="login__omniauth-form" style="display: contents">
        <%= hidden_field_tag "authenticity_token", form_authenticity_token %>
        <button type="submit" class="<%= link_classes %>" title="<%= provider_label %>">
          <%= oauth_icon provider %>
          <span class="sr-only"><%= provider_label %></span>
        </button>
      </form>
    <% end %>
  </div>
  <%- if current_organization.sign_in_enabled? %>
    <span class="login__omniauth-separator"><%= t(".or") %></span>
  <%- end %>
<% end %>
