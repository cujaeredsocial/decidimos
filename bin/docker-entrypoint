#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ] && [ -f /usr/lib/*/libjemalloc.so.2 ]; then
  export LD_PRELOAD="$(echo /usr/lib/*/libjemalloc.so.2)"
fi

SETUP_MARKER=/var/tmp/decidimos-boot-setup-done
if [ "${BOOT_SETUP:-0}" = "1" ] && [ ! -f "$SETUP_MARKER" ]; then
  echo "[docker-entrypoint] bundle install"
  bundle check || bundle install

  case " $* " in
    *" sidekiq "*) ;; # workers don't serve assets
    *)
      if [ "${SKIP_ASSETS_PRECOMPILE:-0}" != "1" ]; then
        echo "[docker-entrypoint] assets:precompile"
        bundle exec rails assets:precompile
      fi
      ;;
  esac

  touch "$SETUP_MARKER"
fi

# If running the rails server then create or migrate existing database
if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
