<%# Override of decidim-core 0.31.5
    app/views/layouts/decidim/header/_main_links_dropdown.html.erb
    (account menu of the header, desktop and mobile).
    Only change: a warning-coloured first item "Verify your account" that links to
    the verified_account workflow while the participant is not verified and the
    organization has the workflow enabled. Re-check this file on every Decidim upgrade. %>
<% unread_data ||= current_user_unread_data %>
<%# Inline !important styles: the dropdown CSS forces svg fill-current and a
    secondary background on hover, and new Tailwind classes would need an
    asset rebuild. %>
<% if DecidimCujae::VerifiedAccount::PendingVerification.for?(current_user) %>
  <li class="dropdown__item" style="margin-bottom: 0.25rem;">
    <%= link_to decidim_verified_account.new_authorization_path,
                class: "dropdown__button",
                style: "background-color: #f59e0b !important; color: #451a03 !important; border-radius: 0.25rem;" do %>
      <%= icon "error-warning-line", style: "fill: #451a03 !important; color: #451a03;" %>
      <span style="color: #451a03 !important; font-weight: 700 !important;"><%= t("decidim_cujae.verified_account.menu.verify") %></span>
      <%= icon "arrow-right-s-line", style: "fill: #451a03 !important; color: #451a03; margin-left: auto;" %>
    <% end %>
  </li>
<% end %>
<li class="dropdown__item">
  <%= link_to decidim.account_path, class: "dropdown__button" do %>
    <%= icon "user-smile-line" %>
    <span><%= t("layouts.decidim.user_menu.profile") %></span>
  <% end %>
</li>
<li class="dropdown__item">
  <%= link_to decidim.profile_path(current_user.nickname), class: "dropdown__button" do %>
    <%= icon "account-circle-line" %>
    <span><%= t("layouts.decidim.user_menu.public_profile") %></span>
  <% end %>
</li>
<li class="dropdown__item">
  <%= link_to decidim.notifications_path, class: "dropdown__button" do %>
    <%= icon "notification-3-line" %>
    <span><%= t("layouts.decidim.user_menu.notifications") %></span>
    <% if unread_data[:unread_notifications] %>
      <%= content_tag :span, "", class: "main-bar__dropdown-notification", data: unread_data %>
      <%= content_tag :span, t("layouts.decidim.user_menu.unread_notifications"), class: "sr-only" %>
    <% end %>
  <% end %>
</li>
<li class="dropdown__item">
  <%= link_to decidim.conversations_path, class: "dropdown__button" do %>
    <%= icon "mail-send-line" %>
    <span><%= t("layouts.decidim.user_menu.conversations") %></span>
    <% if unread_data[:unread_conversations] %>
      <%= content_tag :span, "", class: "main-bar__dropdown-notification", data: unread_data %>
      <%= content_tag :span, t("layouts.decidim.user_menu.unread_conversations"), class: "sr-only" %>
    <% end %>
  <% end %>
</li>
<% if allowed_to? :read, :admin_dashboard %>
  <li class="dropdown__item">
    <%= link_to decidim_admin.root_path, class: "dropdown__button" do %>
      <%= icon "dashboard-line" %>
      <span><%= t("layouts.decidim.user_menu.admin_dashboard") %></span>
    <% end %>
  </li>
<% end %>
<li class="dropdown__item">
  <%= link_to decidim.destroy_user_session_path, method: :delete, class: "dropdown__button" do %>
    <%= icon "logout-box-r-line" %>
    <span><%= t("layouts.decidim.user_menu.log_out") %></span>
  <% end %>
</li>
