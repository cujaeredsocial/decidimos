<%# Import of responses (decidim.survey.responses, docs/survey-exchange-formats.md section 4). %>
<div class="item_show__header" style="border-bottom: none;">
  <h2 class="item_show__header-title"><%= t("decidim.surveys.admin.survey_exchanges.responses.title") %></h2>
</div>
<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <% if responses_errors.any? %>
      <div class="callout alert" role="alert">
        <p><strong><%= responses_errors.first %></strong></p>
        <% if responses_errors.size > 1 %>
          <ul class="list-disc pl-6">
            <% responses_errors.drop(1).first(50).each do |message| %>
              <li><code><%= message %></code></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>
    <% if responses_report %>
      <div class="callout <%= responses_report.errors.any? ? "warning" : "success" %>" role="status">
        <p><strong><%= t("decidim.surveys.admin.survey_exchanges.responses.result", imported: responses_report.imported, skipped: responses_report.skipped.size, errors: responses_report.errors.size) %></strong></p>
        <% if responses_report.discarded.positive? %>
          <p><%= t("decidim.surveys.admin.survey_exchanges.responses.discarded", count: responses_report.discarded) %></p>
        <% end %>
        <% (responses_report.warnings + responses_report.skipped.first(50).map { |s| "#{s[:ref]}: #{s[:reason]}" }).each do |line| %>
          <p><code><%= line %></code></p>
        <% end %>
        <% if responses_report.errors.any? %>
          <ul class="list-disc pl-6">
            <% responses_report.errors.first(100).each do |e| %>
              <li><code><%= [e[:ref], e[:question], e[:code]].compact.join(" · ") %></code> <%= e[:message] %></li>
            <% end %>
          </ul>
        <% end %>
        <details>
          <summary><%= t("decidim.surveys.admin.survey_exchanges.responses.report_json") %></summary>
          <pre class="text-sm" style="white-space: pre-wrap;"><%= JSON.pretty_generate(responses_report.to_h) %></pre>
        </details>
      </div>
    <% end %>
    <%= form_with url: import_survey_responses_exchange_path(survey), method: :post, multipart: true, html: { id: "survey-responses-exchange-form", class: "form form-defaults" } do %>
      <div class="form__wrapper">
        <div class="card">
          <div class="card-section">
            <p class="help-text"><%= t("decidim.surveys.admin.survey_exchanges.responses.help") %></p>
            <div class="row column">
              <%= label_tag :responses_file, t("decidim.surveys.admin.survey_exchanges.responses.file") %>
              <%= file_field_tag :file, id: "responses_file", accept: "application/json,.json", required: true %>
            </div>
            <% if allow_identified_respondents? %>
              <div class="row column">
                <%= label_tag :allow_identified_respondents do %>
                  <%= check_box_tag :allow_identified_respondents, "1", false %>
                  <%= t("decidim.surveys.admin.survey_exchanges.responses.allow_identified") %>
                <% end %>
                <p class="help-text"><%= t("decidim.surveys.admin.survey_exchanges.responses.allow_identified_help") %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <div class="item__edit-sticky">
        <div class="item__edit-sticky-container">
          <%= submit_tag t("decidim.surveys.admin.survey_exchanges.responses.submit"), class: "button button__sm button__secondary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
